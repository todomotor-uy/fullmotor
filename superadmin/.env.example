# The API every site uses. Locally: http://localhost:8080
NEXT_PUBLIC_API_URL=https://api.todomotor.uy
# The site whose sign-in the panel borrows. The API checks the session's site
# against X-Tenant, so this must match the Google client below.
NEXT_PUBLIC_TENANT=todomotor-uy
# That site's Google OAuth client id (public). This app's URL must be one of
# its Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
